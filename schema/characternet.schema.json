{
  “$schema”: “http://json-schema.org/draft-07/schema#”,
  “title”: “CharacterNet v2.0”,
  “type”: “object”,
  “required”: [“characternet”],
  “properties”: {
    “characternet”: {
      “type”: “object”,
      “required”: [“version”, “characters”],
      “properties”: {
        “version”: { “type”: “string” },
        “last_updated”: { “type”: “string”, “format”: “date” },
        “framework”: { “type”: “string” },
        “architecture”: { “type”: “string” },
        “characters”: {
          “type”: “array”,
          “items”: { “$ref”: “#/definitions/character” }
        }
      }
    }
  },
  “definitions”: {
    “character”: {
      “type”: “object”,
      “required”: [“id”, “character”, “pinyin”, “tone”, “tone_contour”, “meaning”, “is_moe_atom”, “visual_pieces”, “binding_constraint”, “connections”],
      “properties”: {
        “id”: { “type”: “string”, “pattern”: “^ATOM-[0-9]{4}$” },
        “character”: { “type”: “string”, “minLength”: 1, “maxLength”: 4 },
        “pinyin”: { “type”: “string”, “minLength”: 1 },
        “tone”: { “type”: “integer”, “minimum”: 1, “maximum”: 4 },
        “tone_contour”: {
          “type”: “string”,
          “enum”: [“flat (ˉ)”, “rising (´)”, “dip-rise (ˇ)”, “falling (ˋ)”]
        },
        “meaning”: { “type”: “string”, “minLength”: 1 },
        “is_moe_atom”: { “type”: “boolean” },
        “visual_pieces”: {
          “type”: “array”,
          “items”: { “type”: “string” },
          “minItems”: 1
        },
        “component_meanings”: { “type”: “object”, “additionalProperties”: { “type”: “string” } },
        “component_pinyin”: { “type”: “object”, “additionalProperties”: { “type”: “string” } },
        “binding_constraint”: { “type”: “string”, “minLength”: 10 },
        “connections”: {
          “type”: “object”,
          “properties”: {
            “component_to_action”: { “type”: “boolean” },
            “identity_link”: { “type”: “boolean” },
            “causal_order”: { “type”: “boolean” },
            “sound_in_action”: { “type”: “boolean” },
            “tone_in_word”: { “type”: “boolean” },
            “meaning_as_payoff”: { “type”: “boolean” }
          },
          “required”: [“component_to_action”, “identity_link”, “causal_order”, “sound_in_action”, “tone_in_word”, “meaning_as_payoff”]
        },
        “tags”: { “type”: “array”, “items”: { “type”: “string” } },
        “family”: { “type”: “string” }
      }
    }
  }
}