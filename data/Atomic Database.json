let ATOMS = {}; 
ATOMS_DATA.forEach(item => { ATOMS[item.character] = item; });


// ==========================================
// 2. THE SQUEEZED FORM MAPPER
// ==========================================
const SQUEEZED_FORMS = {
  '亻': '人', '朩': '木', '氵': '水', '扌': '手', '忄': '心', '讠': '言', '饣': '食', '钅': '金', '纟': '糸', '刂': '刀', '灬': '火'
};


// ==========================================
// 3. THE COMPOUND RESOLVER
// ==========================================
const COMPOUND_MAP = {
  '林': { pinyin: 'lín', tone: 2, meaning: 'forest', parts: ['木', '木'] },
  '森': { pinyin: 'sēn', tone: 1, meaning: 'dense forest', parts: ['木', '木', '木'] },
  '明': { pinyin: 'míng', tone: 2, meaning: 'bright', parts: ['日', '月'] },
  '好': { pinyin: 'hǎo', tone: 3, meaning: 'good', parts: ['女', '子'] },
  '男': { pinyin: 'nán', tone: 2, meaning: 'man', parts: ['田', '力'] }
};


// ==========================================
// 4. THE LOOKUP LOGIC
// ==========================================
function lookup() {
  const input = document.getElementById('charInput').value.trim();
  const resultArea = document.getElementById('resultArea');
  const error = document.getElementById('errorMsg');

  resultArea.classList.add('hidden');
  error.classList.add('hidden');

  if (!input) return;

  let displayData = {
    character: input, pinyin: "--", tone: "--", meaning: "Unknown",
    visual_pieces: [], component_pinyin: {}, component_meanings: {}
  };

  if (ATOMS[input]) {
    displayData = ATOMS[input];
  } 
  else if (COMPOUND_MAP[input]) {
    const compound = COMPOUND_MAP[input];
    displayData.pinyin = compound.pinyin;
    displayData.tone = compound.tone;
    displayData.meaning = compound.meaning;
    
    compound.parts.forEach(rawPart => {
      const cleanPart = SQUEEZED_FORMS[rawPart] || rawPart;
      if (ATOMS[cleanPart]) {
        displayData.visual_pieces.push(...ATOMS[cleanPart].visual_pieces);
        Object.assign(displayData.component_pinyin, ATOMS[cleanPart].component_pinyin);
        Object.assign(displayData.component_meanings, ATOMS[cleanPart].component_meanings);
      } else {
        displayData.visual_pieces.push(rawPart);
        displayData.component_meanings[rawPart] = "Unknown component";
      }
    });
  } 
  else {
    error.classList.remove('hidden');
    return;
  }

  document.getElementById('resChar').textContent = displayData.character;
  document.getElementById('resMeaning').textContent = displayData.meaning;
  
  // Handle the neutral tone display for 了
  let toneDisplay = displayData.tone === 0 ? "Neutral" : `Tone ${displayData.tone}`;
  document.getElementById('resPinyin').textContent = `${displayData.pinyin} · ${toneDisplay}`;

  const tbody = document.getElementById('resTableBody');
  tbody.innerHTML = ''; 

  const pieceCounts = {};
  displayData.visual_pieces.forEach(p => { pieceCounts[p] = (pieceCounts[p] || 0) + 1; });
  const uniquePieces = [...new Set(displayData.visual_pieces)];

  uniquePieces.forEach((piece) => {
    const tr = document.createElement('tr');
    
    const tdVisual = document.createElement('td'); tdVisual.className = 'col-visual'; tdVisual.innerHTML = `<span class="piece-icon">${piece}</span>`;
    const tdQty = document.createElement('td'); tdQty.className = 'col-qty'; tdQty.textContent = `${pieceCounts[piece]}x`;
    const tdName = document.createElement('td'); tdName.className = 'col-name'; tdName.textContent = displayData.component_meanings[piece] || 'Unnamed component';
    const tdPinyin = document.createElement('td'); tdPinyin.className = 'col-pinyin'; tdPinyin.textContent = displayData.component_pinyin[piece] || '--';

    tr.appendChild(tdVisual); tr.appendChild(tdQty); tr.appendChild(tdName); tr.appendChild(tdPinyin);
    tbody.appendChild(tr);
  });

  resultArea.classList.remove('hidden');
}

document.getElementById('charInput').addEventListener('keypress', function (e) {
  if (e.key === 'Enter') lookup();
});
</script>